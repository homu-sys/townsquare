# Optional fixed public URL. When unset, Townsquare derives the base URL from each
# request's Host header (and X-Forwarded-Proto/Host when TS_TRUST_PROXY=true).
# TS_BASE_URL=https://example.com

# What the site calls itself.
TS_SITE_NAME=Townsquare
TS_TAGLINE=a small, self-hosted place to publish things

# Set true when served over HTTPS. Sets Secure on session cookies + HSTS.
TS_SECURE_COOKIES=false

# Allows /setup when there are no users. Set false after creating the admin.
TS_ALLOW_SETUP=true

# Allow signup without an invite code. Invite codes still work when enabled.
TS_OPEN_REGISTRATION=false

# Trust X-Forwarded-* for rate limiting and base URL. Only enable behind a proxy that sets it.
TS_TRUST_PROXY=false

# Allow images hosted on other domains in posts. false blocks remote tracking pixels.
TS_ALLOW_REMOTE_IMAGES=false

# Comma-separated, case-insensitive terms that block a DM and flag it for admins.
# Example: .onion,.i2p,magnet:
TS_DM_BLOCKLIST=

# Check avatar uploads locally with the embedded image safety model.
# Works on linux/amd64; other platforms log a warning and skip the check.
TS_IMAGE_MODERATION=true
TS_IMAGE_NSFW_THRESHOLD=0.60
TS_IMAGE_GORE_THRESHOLD=0.60

# Host port for docker compose.
TS_PORT=8090
